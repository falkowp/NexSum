# NexSum Environment Configuration

# ===== SUMMARIZATION (wybierz jedną opcję) =====

# Opcja 1: Ollama (LOKALNE, DARMOWE, BEZ REJESTRACJI ⭐)
# Instalacja: https://ollama.com/download
# Po instalacji: ollama pull llama3.2:3b
# Uruchomi się automatycznie w tle
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434  # (domyślne)

# Opcja 2: Hugging Face API (darmowe - 1000 requestów/dzień, wymaga konta)
# Zarejestruj się: https://huggingface.co/join
# Wygeneruj token: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your_token_here
# HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Opcja 3: Groq API (darmowy tier, bardzo szybkie, wymaga konta)
# Klucz: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# Opcja 4: OpenAI API (płatne, najlepsza jakość)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Opcja 5: Lokalny model BART (bez instalacji Ollama, najwolniejsze i najsłabsze)
# Zostaw wszystkie powyższe puste i nie instaluj Ollama


# ===== TRANSCRIPTION =====
# Backend: whisper (domyślny), faster-whisper, whisper-cpp
TRANSCRIBER_BACKEND=whisper

# Model Whisper: tiny, base, small, medium, large
WHISPER_MODEL=base

# Dla whisper.cpp (opcjonalne):
# WHISPER_CPP_BIN=path/to/whisper.cpp/main
# WHISPER_CPP_MODEL=path/to/ggml-model.bin
# WHISPER_CPP_THREADS=4
